# Local disposable databases only. Peer auth, no password.
# Refuse any URL that is not fs_payload_spike, fs_payload_b, or fs_payload_collide.
SPIKE_DATABASE_URL=postgresql://ubuntu@/fs_payload_spike?host=/var/run/postgresql
SPIKE_DATABASE_URL_B=postgresql://ubuntu@/fs_payload_b?host=/var/run/postgresql
SPIKE_DATABASE_URL_COLLIDE=postgresql://ubuntu@/fs_payload_collide?host=/var/run/postgresql
PAYLOAD_SECRET=generate-locally-do-not-commit
SPIKE_SCHEMA=payload
SPIKE_TABLE_PREFIX=m13_
SPIKE_PUSH=true
