# edit.fieldschool.ai on the Field School VPS Docker Caddy.
# Caddy must be on network fieldschool-video. Do not use 127.0.0.1 here.
edit.fieldschool.ai {
	handle /trigger {
		reverse_proxy fieldschool-trigger:8789
	}
	handle /trigger/* {
		reverse_proxy fieldschool-trigger:8789
	}
	reverse_proxy fieldschool-edit:8788
}
